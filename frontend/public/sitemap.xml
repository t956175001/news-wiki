<?xml version="1.0" encoding="UTF-8"?>
<!-- The five routes from ARCHITECTURE section 6. Entity detail pages are not
     listed: they are generated from a database that changes daily, and a
     sitemap that has to be regenerated on every ingest is a maintenance cost
     this project does not need. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://newswiki.cn/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://newswiki.cn/wiki</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://newswiki.cn/graph</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://newswiki.cn/ops</loc>
    <changefreq>daily</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://newswiki.cn/api/v1/docs/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
