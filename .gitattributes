# Normalise to LF in the repository. CI runs on Ubuntu and the production
# image is Linux, so shell scripts and container files must not arrive with
# CRLF endings after a checkout on Windows.
* text=auto

*.sh text eol=lf
*.py text eol=lf
# The demo fixture is 1.4 MB of one-record-per-line JSON; without this it
# re-writes end to end every time it is dumped on a different platform.
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
