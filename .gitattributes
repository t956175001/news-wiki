# Normalise to LF in the repository. CI runs on Ubuntu and the production
# image is Linux, so shell scripts and container files must not arrive with
# CRLF endings after a checkout on Windows.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
