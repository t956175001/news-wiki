# ============================================
# news-wiki 环境变量模板
# 用法：cp .env.example .env 后填写
# ⚠️ .env 永远不要提交到仓库
# ⚠️ 本文件中所有敏感值必须是 replace-me，不要贴真实值
# ============================================

# --- Django ---
DJANGO_ENV=dev                          # dev | prod
SECRET_KEY=replace-me
# 生成：python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_DOMAIN=localhost                   # 生产填 news-wiki.yourdomain.com

# --- Database ---
POSTGRES_DB=newswiki
POSTGRES_USER=newswiki
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://newswiki:replace-me@localhost:5432/newswiki
# Docker Compose 内部访问时 host 用 db：
# DATABASE_URL=postgres://newswiki:replace-me@db:5432/newswiki

# --- LLM (智谱 GLM) ---
GLM_API_KEY=replace-me
# 申请：https://open.bigmodel.cn
GLM_MODEL=glm-4.7
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_RATE_LIMIT_RPM=60
LLM_TIMEOUT_SECONDS=300                 # 单次请求超时；推理模型实测 85-110s，120s 不够

# --- 抽取管线 ---
EXTRACT_BATCH_SIZE=5                    # 单次 LLM 调用喂几篇文章
EXTRACT_CONTENT_LIMIT=4000              # 单篇正文截断字符数

# --- 演示模式与成本护栏 ---
DEMO_MODE=true                          # true 时写操作走 IP 限流
DEMO_WRITE_RATE=3/day                   # DRF throttle 速率
LLM_DAILY_BUDGET_CNY=5.0                # 日成本熔断阈值（人民币元）

# --- 定时任务 ---
CRON_TOKEN=replace-me
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 同时配置到 GitHub repo secrets

# --- CORS ---
# 同源部署时留空；前后端分离时填前端域名，逗号分隔
CORS_ALLOWED_ORIGINS=

# --- 出站代理（可选，留空即直连）---
HTTP_PROXY=
HTTPS_PROXY=

# --- 日志 ---
LOG_DIR=backend/logs
LOG_LEVEL=INFO
